# Fill these before starting. Keep .env out of Git.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=

# By default the web UI is available only on this host.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# HTTPS address of the UniFi Network application and its Network API key.
UNIFI_URL=
UNIFI_API_KEY=
UNIFI_SITE=default
UNIFI_SITE_UUID=

# Optional: resolve UNIFI_URL through a specific address while retaining its TLS name.
UNIFI_CONNECT_IP=
# For a private CA, uncomment the collector volume in docker-compose.yml first.
# UNIFI_CA_FILE=/run/secrets/unifi-ca.pem
UNIFI_CA_FILE=

# Display changes in UniFi API counters as "controller reported" usage.
UNIFI_WIRED_SCOPE=reported
UNIFI_WIRED_RX_DIRECTION=upload
UNIFI_WIRELESS_SCOPE=reported
UNIFI_WIRELESS_RX_DIRECTION=upload
COLLECT_INTERVAL_MS=30000
