# Fill these before starting. Keep .env out of Git.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=

# By default the web UI is available only on this host.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# HTTPS address of the UniFi Network application and its Network API key.
# The URL hostname must match the certificate. If DNS cannot reach it, set UNIFI_CONNECT_IP below.
UNIFI_URL=
UNIFI_API_KEY=
UNIFI_SITE=default
UNIFI_SITE_UUID=

# Optional: resolve UNIFI_URL through a specific address while retaining its TLS name.
UNIFI_CONNECT_IP=
# UniFi's default HTTPS certificate is self-signed. Save it as a PEM file (see README,
# "UniFi 인증서(CA) 설정"), put its absolute path on the Docker host below, and
# uncomment COMPOSE_FILE so docker-compose.ca.yml mounts it at /run/secrets/unifi-ca.pem.
# Do not set UNIFI_CA_FILE here; that is the path inside the container.
# With a publicly trusted certificate, leave both lines empty or commented out.
UNIFI_CA_HOST_FILE=
#COMPOSE_FILE=docker-compose.yml:docker-compose.ca.yml

# Display changes in UniFi API counters as "controller reported" usage.
UNIFI_WIRED_SCOPE=reported
UNIFI_WIRED_RX_DIRECTION=upload
UNIFI_WIRELESS_SCOPE=reported
UNIFI_WIRELESS_RX_DIRECTION=upload
COLLECT_INTERVAL_MS=30000

# Optional gateway agent (agent/README.md). Set all three or leave all empty.
# Run /data/unifi-traffic-agent/manage.sh info and token on the gateway to get these values.
UNIFI_AGENT_URL=
UNIFI_AGENT_TOKEN=
UNIFI_AGENT_CERT_SHA256=
