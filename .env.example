# Use a long random value. Keep this file out of Git after copying to .env.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Used once to create the first account in a new database. Changing these later does not reset its password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to ghcr.io/aroxu/unifi-traffic-monitr:latest for GHCR, or leave blank for local builds.
UTM_IMAGE=
WEB_BIND=127.0.0.1
WEB_PORT=3000
# For running without Compose, set a local PostgreSQL connection URL.
DATABASE_URL=

# Network application endpoint and API key are used only by collector at runtime.
UNIFI_URL=https://your-unifi-network-endpoint
UNIFI_CONNECT_IP=
# Path inside the collector container; mount a trusted CA with a local Compose override if needed.
UNIFI_CA_FILE=
UNIFI_SITE=default
# UUID of the same site from the official Network API.
UNIFI_SITE_UUID=
UNIFI_API_KEY=
# Optional local session cookie if API key cannot read the internal endpoint.
UNIFI_COOKIE=
# Set scope=reported to chart UniFi API counters without claiming internet/LAN coverage.
# Set rxDirection=upload when API rx is traffic from the client to the network.
# A complete pair enables new usage intervals for that connection type.
UNIFI_WIRED_SCOPE=
UNIFI_WIRED_RX_DIRECTION=
UNIFI_WIRELESS_SCOPE=
UNIFI_WIRELESS_RX_DIRECTION=
COLLECT_INTERVAL_MS=30000
