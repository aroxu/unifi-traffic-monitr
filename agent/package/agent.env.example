# Created by manage.sh install. Keep this file mode 600.
# Comma-separated IP:port addresses to listen on. Use LAN addresses only.
AGENT_LISTEN=192.168.1.1:8790
# Bearer token required by the collector. Generate with: unifi-traffic-agent gen-token
AGENT_TOKEN=
# Hours of finished five-minute buckets kept in memory for collectors that
# were offline (1-168). Nothing is written to disk; restarting the agent
# clears the buffer.
AGENT_BUFFER_HOURS=24
# Conntrack read interval while a collector is connected, and while none is.
AGENT_LIVE_INTERVAL_MS=1000
AGENT_IDLE_INTERVAL_MS=10000
# Interfaces whose networks contain clients.
AGENT_CLIENT_INTERFACES=br*
